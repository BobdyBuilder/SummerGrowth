:: BodyTypeUpgrade [nobr] {"position":"1000,100","size":"100,100"}
<<set _oldBodyType to $bodyType>>

<<if $muscle <= 20>>
	<<if $fat <= 20>> <<set $bodyType to "skinny">>
		<<script>>
			document.documentElement.style.setProperty('--mcIcon', 'URL("https://github.com/BobdyBuilder/SummerGrowth/blob/main/Art%20assets/PlayerBusts/Skinny.png?raw=true")');
		<</script>>
	<<elseif $fat <= 40>> <<set $bodyType to "average">>
