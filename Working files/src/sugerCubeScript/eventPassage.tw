:: eventPassage [noReturnDialog] {"position":"1400,200","size":"100,100"}
<<nobr>>
<<script>>
	console.log("Used event: " + State.variables.currentEvent.name);
	console.log(State.variables.currentEvent);
<</script>>
<</nobr>><<print $currentEvent.content>>
<<if !$currentEvent.content.includes('<<link ')>>
<<link "Continue" $currentScene>><</link>>
<</if>>

<<nobr>>
<<set _trackableNpcs to ["johan", "kris", "emma", "elena", "nat"]>>
<<for _npcIndex to 0; _npcIndex < _trackableNpcs.length; _npcIndex++>>
	<<capture _npcIndex>>
	<<if $currentEvent.npc.includes(_trackableNpcs[_npcIndex])>>
		<<updateNPCLastSeen _trackableNpcs[_npcIndex]>>
	<</if>>
	<</capture>>
<</for>>

<</nobr>>


